HARNESS_MODE=fake
HARNESS_SERVICE_TOKEN=replace-with-a-long-random-secret
HARNESS_HOST=127.0.0.1
HARNESS_PORT=8090
HARNESS_WORKSPACE_ROOT=.workspaces
DSH_HOME=.dsh-runtime
DSH_TRIPFORGE_PATCH=config/tripforge.patch.yml
DSH_PERMISSION_MODE=read-only
HARNESS_RUN_TIMEOUT_MS=300000
HARNESS_MAX_OUTPUT_BYTES=1048576

# Used only when HARNESS_MODE=deepseek.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DSH_MODEL=deepseek-v4-flash
# Pin this to a tested version before deployment, e.g. @deepseek-ai/dsh@x.y.z.
DSH_PACKAGE=@deepseek-ai/dsh
# Optional installed executable. When omitted, npx.cmd is used on Windows.
DSH_COMMAND=
