HARNESS_MODE=fake
HARNESS_SERVICE_TOKEN=replace-with-a-long-random-secret
HARNESS_HOST=127.0.0.1
HARNESS_PORT=8090
HARNESS_WORKSPACE_ROOT=.workspaces
HARNESS_INSPECTOR_PORT=8091
HARNESS_INSPECTOR_WORKSPACE=.inspector-workspace
DSH_HOME=.dsh-runtime
DSH_INSPECTOR_HOME=.dsh-inspector
DSH_TRIPFORGE_PATCH=config/tripforge.patch.yml
DSH_PERMISSION_MODE=read-only
HARNESS_RUN_TIMEOUT_MS=300000
HARNESS_MAX_OUTPUT_BYTES=1048576

# OpenCode Zen model provider. Keep these values server-side only.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://opencode.ai/zen/v1
DSH_MODEL=nemotron-3.5-lightning-free
# Bound retained input context and generated output per model request.
DSH_CONTEXT_WINDOW_TOKENS=65536
DSH_MAX_OUTPUT_TOKENS=4096
# Enables the read-only search_google_places Harness plugin.
GOOGLE_MAPS_API_KEY=
# Routes stays installed but disabled until this flag is explicitly true.
TRIPFORGE_GOOGLE_ROUTES_ENABLED=false
# Optional prompt overrides; defaults live under harness/prompts/.
# TRIPFORGE_SUPERVISOR_PROMPT_PATH=prompts/supervisor.md
# TRIPFORGE_HEADLESS_TASK_PROMPT_PATH=prompts/headless-task.md
# Pin this to a tested version before deployment, e.g. @deepseek-ai/dsh@x.y.z.
DSH_PACKAGE=@deepseek-ai/dsh
# Optional installed executable. When omitted, npx.cmd is used on Windows.
DSH_COMMAND=
