APP_ENV=development
APP_CORS_ORIGINS=["http://localhost:3000"]

# The service falls back to a limited local parser when this key is absent.
# The fallback can clarify requests but never fabricates travel research.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Enable Places API (New) and Routes API for this server-side key.
GOOGLE_MAPS_API_KEY=

# Supabase project settings. Find URL and keys under Project Settings > API.
# The service-role key is backend-only: never prefix it with NEXT_PUBLIC_ or expose it.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Set false only for isolated, API-less tests. Deployed environments should use true.
SUPABASE_AUTH_REQUIRED=true

RUN_RETENTION_SECONDS=3600
SSE_HEARTBEAT_SECONDS=15
